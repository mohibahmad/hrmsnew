rules_version = '2';

// HRMS Firestore security rules.
//
// Data model: every user owns a single document at `hrms_user/{userKey}`,
// where userKey is the user's lowercased email (or their uid when no email is
// available). All HRMS data (workers, expenses, attendance, payroll, timeoff,
// assets, holidays) lives in subcollections beneath that document. A user may
// only ever read or write their own document tree.
service cloud.firestore {
  match /databases/{database}/documents {

    // The authenticated user's owner key, mirroring FirestoreService._userKey:
    // prefer the lowercased email, fall back to the uid.
    function ownerKey() {
      return request.auth.token.email != null && request.auth.token.email != ''
        ? request.auth.token.email.lower()
        : request.auth.uid;
    }

    function isOwner(userKey) {
      return request.auth != null && userKey == ownerKey();
    }

    // The owner document and everything beneath it.
    match /hrms_user/{userKey} {
      allow read, write: if isOwner(userKey);

      // All HRMS subcollections inherit the same per-owner restriction.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userKey);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
