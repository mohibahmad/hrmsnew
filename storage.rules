rules_version = '2';

// HRMS Cloud Storage security rules.
//
// Two upload locations are used by the app today:
//   * profile_pics/profile_{uid}_{timestamp}.png  (profile_screen.dart)
//   * hrms_documents/{folder}/{timestamp}_{name}  (add_worker_flow.dart)
//
// Both require an authenticated (non-anonymous data is fine, but auth must
// exist) user. Reads are allowed for any authenticated user because download
// URLs are stored on Firestore documents the owner already controls; writes
// are constrained by size and content type to prevent abuse.
//
// NOTE: these paths are not yet namespaced per-user. A future hardening step
// is to move uploads under `users/{uid}/...` and scope read/write to the
// owning uid. See README "Security" section.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    // Profile pictures: images only, max 5 MB.
    match /profile_pics/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageUnder(5 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Worker documents/attachments: max 15 MB, any content type.
    match /hrms_documents/{folder}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
